# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (Office 365 / Exchange — required; never commit real values)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_mailbox@yourcompany.com
EMAIL_PASSWORD=your_rotated_password_or_app_password_here
# Alias aceito por alguns módulos: EMAIL_PASS
EMAIL_FROM="ABZ Group <your_mailbox@yourcompany.com>"
EMAIL_REPLY_TO=your_mailbox@yourcompany.com
# exchange | gmail | sendgrid (optional; admin UI can override via app_secrets)
EMAIL_PROVIDER=exchange
# smtp | graph | auto — auto uses Microsoft Graph for Exchange when MS_GRAPH_* is set (avoids Outlook 535)
EMAIL_TRANSPORT=auto
# Prefer Admin -> /admin/email-settings to persist credentials in app_secrets (DB). Env is bootstrap/fallback only.

# Microsoft Graph mail (recommended for O365 when SMTP AUTH is blocked)
# App registration needs Application permission Mail.Send + admin consent. TENANT_ID must be the tenant GUID (not "common").
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Legacy aliases (optional)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_mailbox@yourcompany.com
SMTP_PASSWORD=your_rotated_password_or_app_password_here

# WKRadar default password (server-only — NEVER use NEXT_PUBLIC_*)
WKRADAR_DEFAULT_PASSWORD=set_a_strong_unique_default_here

# Email debug API in production (default off)
ALLOW_EMAIL_DEBUG=false

# API Keys
OPENAI_API_KEY=sk-your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./public/uploads

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Third-party Services
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Admin Configuration (required for ensure-admin / create-admin helpers)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PHONE_NUMBER=+5500000000000
ADMIN_PASSWORD=set_a_strong_admin_password_here
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_TOKEN=your_admin_token_here

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
